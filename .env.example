# Copien este archivo a .env y completen con su modelo. El API y la app lo leen con python-dotenv (ver README).
MODEL_ID=usuario/mi-modelo        # identificador del modelo afinado en el Hub de Hugging Face
TASK=text                         # "text" (clasificación de texto) o "image" (clasificación de imágenes)
API_URL=http://localhost:8000     # dónde corre el API (lo usa la app)
